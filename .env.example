# AI-generated cover photos (Hide tab -> Hidden in a photo -> "Generate cover with AI").
# Copy this file to .env and fill in at least one provider, then run `npm run dev`.
# Keys stay on the dev server: they are never sent to the browser or put into the built site.
# The published GitHub Pages site has no AI feature.

# Optional: which configured provider to list first (openai, azure, gemini or stability).
AI_IMAGE_PROVIDER=

# OpenAI
OPENAI_API_KEY=
# OPENAI_IMAGE_MODEL=gpt-image-1
# OPENAI_BASE_URL=https://api.openai.com/v1

# Azure OpenAI (all three are needed)
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_IMAGE_DEPLOYMENT=
# AZURE_OPENAI_API_VERSION=2025-04-01-preview

# Google Gemini (GOOGLE_API_KEY also works)
GEMINI_API_KEY=
# GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# Stability AI
STABILITY_API_KEY=
# STABILITY_IMAGE_MODEL=core
